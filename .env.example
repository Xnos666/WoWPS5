# Copy to .env (which is never committed) and fill in.

# Your own World of Warcraft installation: the folder that holds Data and _classic_beta_ (WoW Forever)
# and/or _classic_era_ (WoW Classic Era). WOW_FLAVOR=_classic_era_ copies only that one.
# The game is not part of this project; tools/wine-ps5/stage-game.py copies it to the console from here.
WOW_INSTALL="/path/to/World of Warcraft"

# The console (read by vendor/PS5_Vulkan/tools/ps5_console.py from vendor/PS5_Vulkan/.env):
# PS5_HOST, PS5_FTP_PORT, PS5_FTP_USER, PS5_FTP_PASSWORD
